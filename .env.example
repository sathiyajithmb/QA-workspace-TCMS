# PostgreSQL connection: edit these fields in this one file.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=qamanager
DB_USER=qa
DB_PASSWORD=replace-with-a-unique-random-database-password
JWT_SECRET=replace-with-a-long-random-signing-secret
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
SESSION_HOURS=8
COOKIE_SECURE=false
MAX_UPLOAD_BYTES=10485760

# Bitbucket Cloud: optional automation trigger and report callback
BITBUCKET_EMAIL=
BITBUCKET_API_TOKEN=
# App base URL reachable from the runner PC (no /api suffix)
QA_PUBLIC_URL=
